# Copie este archivo como .env y escriba SU clave. .env está en .gitignore.
# Las verificaciones (verificar_casos.py, pytest) NO usan clave ni consultan al proveedor.

# Proveedor del modelo: OpenRouter (API compatible con OpenAI). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo con soporte de herramientas. Gratuitos: https://openrouter.ai/models?supported_parameters=tools&max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Opcional: modelo para la etapa de revisión (por defecto, el mismo).
# OPENROUTER_MODEL_REVISION=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Servidor MCP (debe estar iniciado antes que main.py)
DES_MCP_URL=http://127.0.0.1:8765/mcp
# DES_MCP_HOST=127.0.0.1
# DES_MCP_PUERTO=8765

# Carpeta de evidencias (por defecto ./evidencias)
# DES_EVIDENCIAS=
